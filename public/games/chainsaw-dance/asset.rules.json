{
  "rules": [
    { "match": "html5game/benedance_texture_0\\.png", "role": "atlas-texture", "screens": ["title", "menu", "select", "gameplay", "score"], "note": "Texture atlas GameMaker #0: contiene quasi tutti gli sprite 2D del gioco (artwork titolo, dancers, frecce, dancepad, UI). Per reskin: stessa griglia pixel, stesso PNG." },
    { "match": "html5game/benedance_texture_1\\.png", "role": "atlas-texture", "screens": ["title", "menu", "select", "gameplay", "score"], "note": "Texture atlas GameMaker #1: secondo set di sprite. Per reskin: stessa griglia pixel, stesso PNG." },
    { "match": "html5game/snd_thunder", "role": "sfx", "screens": ["title"], "note": "Tuono dello splash iniziale." },
    { "match": "html5game/snd_start", "role": "sfx", "screens": ["menu"], "note": "Jingle di avvio del menu." },
    { "match": "html5game/snd_ambient", "role": "music", "screens": ["menu"], "note": "Musica ambient del menu arcade." },
    { "match": "html5game/game_start__1_", "role": "sfx", "screens": ["menu"], "note": "Suono di start da menu." },
    { "match": "html5game/click_short1", "role": "sfx", "screens": ["menu", "select"], "note": "Click breve UI (navigazione menu)." },
    { "match": "html5game/s_sob", "role": "sfx", "screens": ["select"], "note": "SFX selection (pianto/sob dei dancer)." },
    { "match": "html5game/s_one", "role": "sfx", "screens": ["gameplay"], "note": "SFX beat 'one' del metronomo di gioco." },
    { "match": "html5game/snd_bug_thif", "role": "music", "screens": ["select", "gameplay"], "note": "Brano: Bug Thief (vance). Audio completo del livello." },
    { "match": "html5game/chainsawvance", "role": "music", "screens": ["select", "gameplay"], "note": "Brano vance Chainsaw (loop di gioco)." },
    { "match": "html5game/snd_makima_start", "role": "music", "screens": ["select", "gameplay"], "note": "Brano Makima — parte intro." },
    { "match": "html5game/snd_makima_loop", "role": "music", "screens": ["select", "gameplay"], "note": "Brano Makima — loop principale." },
    { "match": "html5game/snd_phut", "role": "music", "screens": ["select", "gameplay"], "note": "Brano: Phut Hon (audio completo)." },
    { "match": "html5game/snd_tokyo", "role": "music", "screens": ["select", "gameplay"], "note": "Brano: Tokyo Drift (audio completo)." },
    { "match": "html5game/snd_fresh", "role": "music", "screens": ["select", "gameplay"], "note": "Brano: Fresh (audio completo)." },
    { "match": "html5game/snd_garden", "role": "music", "screens": ["select", "gameplay"], "note": "Brano: Garden Party (audio completo)." },
    { "match": "html5game/snd_dope", "role": "music", "screens": ["select", "gameplay"], "note": "Brano: Dope (audio completo, Boys/Girls nella lista)." },
    { "match": "html5game/snd_stars", "role": "music", "screens": ["select", "gameplay"], "note": "Brano: Shooting Stars (audio completo)." },
    { "match": "html5game/KOBENI_SCORE", "role": "music", "screens": ["score"], "note": "Musica schermata punteggio di Kobeni." },
    { "match": "html5game/snd_countdown", "role": "sfx", "screens": ["gameplay"], "note": "Countdown 3-2-1 pre-partita." },
    { "match": "html5game/e_hit", "role": "sfx", "screens": ["gameplay"], "note": "Suono hit della nota." },
    { "match": "html5game/e_long_note", "role": "sfx", "screens": ["gameplay"], "note": "Suono nota lunga (hold)." },
    { "match": "html5game/SFX_Jump_", "role": "sfx", "screens": ["gameplay"], "note": "SFX salto/passi sul dancepad (4 varianti)." },
    { "match": "html5game/snd_fail", "role": "sfx", "screens": ["score"], "note": "Suono fallimento." },
    { "match": "html5game/snd_victory", "role": "sfx", "screens": ["score"], "note": "Suono vittoria." },
    { "match": "html5game/game_over_applause", "role": "sfx", "screens": ["score"], "note": "Applausi di game over / fine brano." },
    { "match": "html5game/final_result", "role": "music", "screens": ["score"], "note": "Musica schermata risultato finale." },
    { "match": "html5game/snd_good_refult", "role": "sfx", "screens": ["score"], "note": "Suono risultato positivo." },
    { "match": "html5game/snd_bad_result", "role": "sfx", "screens": ["score"], "note": "Suono risultato negativo." },
    { "match": "html5game/snd_result_hit", "role": "sfx", "screens": ["score"], "note": "Hit sonoro dei risultati." },
    { "match": "html5game/score_bg_sound", "role": "music", "screens": ["score"], "note": "Musica di fondo score screen." },
    { "match": "html5game/score_count", "role": "sfx", "screens": ["score"], "note": "Tick di conteggio punteggio." },
    { "match": "html5game/snd_score_tick", "role": "sfx", "screens": ["score"], "note": "Tick punteggio alternativo." },
    { "match": "html5game/snd_score_prefect_tick", "role": "sfx", "screens": ["score"], "note": "Tick punteggio perfetto." },
    { "match": "html5game/snd_fnf_score_screen", "role": "music", "screens": ["score"], "note": "Musica score screen in stile FNF (omaggio)." }
  ],
  "exclude": [
    "html5game/tph_newgroundsio\\.js",
    "html5game/uph_ng_library\\.js",
    "html5game/wph_test\\.js",
    "html5game/xph_js\\.js",
    "html5game/benedance\\.js",
    "html5game/resources\\.dat",
    "html5game/gamedata\\.ini",
    "html5game/dancedata\\.ini",
    "html5game/sets\\.ini",
    "index\\.html"
  ],
  "notes": {
    "reskin": "GameMaker compatta tutti gli sprite nelle texture atlas PNG. Per reskinare: sostituisci i pixel dentro benedance_texture_0/1.png mantenendo ESATTAMENTE le stesse posizioni/quote. Gli audio (OGG) si sostituiscono mantenendo stesso nome file e formato.",
    "dancerCustom": "Il gioco supporta dancer esterni personalizzati (<nome>dancer_sprite.png + dancer_icon.png + dancer_score_icon.png): il CDN non li pubblica (404), sono opzionali."
  }
}
