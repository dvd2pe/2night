{
  "rules": [
    { "match": "assets/images/logoBumpin\\.png", "role": "sprite-atlas", "screens": ["title"], "note": "Logo animato FRIDAY NIGHT FUNKIN' del titolo (atlas Sparrow: animazione 'bump' a tempo di musica)." },
    { "match": "assets/images/gfDanceTitle\\.png", "role": "sprite-atlas", "screens": ["title"], "note": "Girlfriend che balla sugli speaker nella schermata titolo (atlas Sparrow: animazioni dance)." },
    { "match": "assets/images/titleEnter\\.png", "role": "sprite", "screens": ["title"], "note": "Scritta 'Press Enter to Begin' che pulsa." },
    { "match": "assets/images/newgrounds_logo\\.png", "role": "sprite", "screens": ["title"], "note": "Logo Newgrounds (splash)." },
    { "match": "assets/images/FNF_main_menu_assets", "role": "sprite-atlas", "screens": ["menu"], "note": "Sprites del menu principale: icone voce (story/freeplay/donate...), freccia di selezione, logo scartato." },
    { "match": "assets/images/menuBG\\.png", "role": "background", "screens": ["menu", "story", "freeplay"], "note": "Sfondo standard dei menu (circa 1280x720)." },
    { "match": "assets/images/menuBGBlue\\.png", "role": "background", "screens": ["freeplay"], "note": "Sfondo menu variante blu (freeplay)." },
    { "match": "assets/images/menuBGMagenta\\.png", "role": "background", "screens": ["freeplay"], "note": "Sfondo menu variante magenta (freeplay)." },
    { "match": "assets/images/menuDesat\\.png", "role": "background", "screens": ["menu"], "note": "Sfondo menu desaturato (usato da effetti/menus)." },
    { "match": "assets/images/alphabet\\.png", "role": "font-sprite", "screens": ["menu", "story", "freeplay", "gameplay"], "note": "Alphabet: font a sprite usato per quasi tutti i testi di gioco." },
    { "match": "assets/images/buttons\\.png", "role": "sprite", "screens": ["gameplay"], "note": "Pulsanti touch on-screen (mobile)." },
    { "match": "assets/images/campaign_menu_UI_assets\\.png", "role": "sprite-atlas", "screens": ["story"], "note": "UI della selezione settimana: frecce, lucchetto LOCK, pannelli." },
    { "match": "assets/images/campaign_menu_UI_characters\\.png", "role": "sprite-atlas", "screens": ["story"], "note": "Ritratti personaggi della selezione settimana (Dad, Skid&Pump, Pico, Mom, Monster, Senpai, Tankman)." },
    { "match": "assets/images/storymenu/week([0-9])\\.png", "role": "sprite", "screens": ["story"], "note": "Banner della settimana $1 nello Story Mode." },
    { "match": "assets/images/iconGrid\\.png", "role": "sprite", "screens": ["gameplay"], "note": "Griglia 150 icone salute (stati win/lose di ogni personaggio)." },
    { "match": "assets/images/num([0-9])\\.png", "role": "sprite", "screens": ["gameplay"], "note": "Cifra $1 per il conteggio punteggio a schermo." },
    { "match": "assets/images/logo\\.png", "role": "sprite", "screens": ["menu"], "note": "Logo statico (icona menu)." },
    { "match": "assets/shared/images/BOYFRIEND\\.png", "role": "sprite-atlas", "screens": ["gameplay"], "note": "BOYFRIEND: personaggio giocante (atlas Sparrow, animazioni idle/miss/dies)." },
    { "match": "assets/shared/images/GF_assets\\.png", "role": "sprite-atlas", "screens": ["gameplay", "title"], "note": "GIRLFRIEND: animazioni dance/cheer/cry (usata anche sul titolo)." },
    { "match": "assets/shared/images/DADDY_DEAREST\\.png", "role": "sprite-atlas", "screens": ["gameplay"], "note": "DADDY DEAREST: antagonista Week 1 (atlas Sparrow)." },
    { "match": "assets/shared/images/NOTE_assets\\.png", "role": "sprite-atlas", "screens": ["gameplay"], "note": "NOTE ASSETS: le 4 frecce strumline e le note che salgono. Asset chiave del gameplay." },
    { "match": "assets/shared/images/healthBar\\.png", "role": "ui", "screens": ["gameplay"], "note": "Barra salute rossa/verde." },
    { "match": "assets/shared/images/grafix\\.png", "role": "sprite", "screens": ["gameplay"], "note": "Grafica combo/punteggio flottante." },
    { "match": "assets/shared/images/(sick|good|bad|shit)\\.png", "role": "sprite", "screens": ["gameplay"], "note": "Giudizi delle note ($1) in stile alfabeto." },
    { "match": "assets/shared/images/(go|ready|set)\\.png", "role": "sprite", "screens": ["gameplay"], "note": "Countdown 'GO/READY/SET'." },
    { "match": "assets/shared/images/lose\\.png", "role": "sprite-atlas", "screens": ["gameover"], "note": "Girlfriend che ride (Game Over) + testa di Boyfriend." },
    { "match": "assets/shared/images/pauseAlt/", "role": "ui", "screens": ["pause"], "note": "Asset menu pausa alternativo (sfondo, UI, BF seduto)." },
    { "match": "assets/shared/images/backspace\\.png", "role": "ui", "screens": ["freeplay"], "note": "Indicatore BACK per tornare indietro." },
    { "match": "assets/shared/images/(stageback|stagefront|stagecurtains|stage_light)", "role": "background", "screens": ["gameplay"], "note": "Palco Week 1: fondo scena, palco frontale, sipario rosso, luci." },
    { "match": "assets/shared/images/speech_bubble_talking", "role": "ui", "screens": ["week6"], "note": "Bolle di dialogo pixel (week 6)." },
    { "match": "assets/shared/images/(missnote|screencapTierImage|week54prototype|zzzzzzzz|lol\\.png|bfLol)", "role": "sprite", "screens": ["gameplay"], "note": "Asset secondari/nascosti (screenshot meme, prototype, note mancate)." },
    { "match": "assets/week2/images/", "role": "sprite-atlas", "screens": ["gameplay"], "note": "Week 2 (Spooky Kids): Skid & Pump, sfondo halloween." },
    { "match": "assets/week3/images/", "role": "sprite", "screens": ["gameplay"], "note": "Week 3 (Pico): Pico e stage Philadelphia (cielo, grattacieli, treno)." },
    { "match": "assets/week4/images/", "role": "sprite-atlas", "screens": ["gameplay"], "note": "Week 4 (Mommy Mearest): Mom, limo, dancer, tramonto." },
    { "match": "assets/week5/images/", "role": "sprite-atlas", "screens": ["gameplay"], "note": "Week 5 (Christmas Monster): palco natalizio, BG cattivi, Santa." },
    { "match": "assets/week6/images/", "role": "sprite", "screens": ["week6"], "note": "Week 6 (Senpai): grafica pixel-style, dialoghi, Spirit." },
    { "match": "assets/shared/music/gameOver\\.mp3", "role": "music", "screens": ["gameover"], "note": "Musica Game Over (Blue Balls Anthem loop)." },
    { "match": "assets/shared/music/gameOverEnd\\.mp3", "role": "music", "screens": ["gameover"], "note": "Fine musicale del game over (ripresa)." },
    { "match": "assets/shared/music/breakfast\\.mp3", "role": "music", "screens": ["pause"], "note": "Musica del menu pausa." },
    { "match": "assets/week6/music/Lunchbox", "role": "music", "screens": ["week6"], "note": "Musica dialoghi Week 6 (Lunchbox / LunchboxScary)." },
    { "match": "assets/week6/music/gameOver-pixel", "role": "music", "screens": ["week6"], "note": "Game Over in versione pixel (Week 6)." },
    { "match": "assets/shared/sounds/missnote", "role": "sfx", "screens": ["gameplay"], "note": "Suono nota mancata (3 varianti)." },
    { "match": "assets/shared/sounds/badnoise", "role": "sfx", "screens": ["gameplay"], "note": "Rumore nota sbagliata (3 varianti)." },
    { "match": "assets/shared/sounds/intro([123])\\.mp3", "role": "sfx", "screens": ["gameplay"], "note": "Countdown '3/2/1' pre-canzone ($1)." },
    { "match": "assets/shared/sounds/introGo", "role": "sfx", "screens": ["gameplay"], "note": "Countdown 'GO!'" },
    { "match": "assets/shared/sounds/fnf_loss_sfx", "role": "sfx", "screens": ["gameover"], "note": "SFX di sconfitta (Blue Balls)." },
    { "match": "assets/shared/sounds/GF_", "role": "sfx", "screens": ["gameplay"], "note": "Risate di Girlfriend (4 varianti)." },
    { "match": "assets/shared/sounds/thunder_", "role": "sfx", "screens": ["gameplay"], "note": "Tuoni Week 2 (spooky)." },
    { "match": "assets/shared/sounds/(train_passes|carPass)", "role": "sfx", "screens": ["gameplay"], "note": "Ambienti Week 3/4: treno e auto che passano." },
    { "match": "assets/shared/sounds/(ANGRY|ANGRY_TEXT_BOX|clickText|pixelText|Lights_|Senpai_Dies)", "role": "sfx", "screens": ["week6"], "note": "SFX dialoghi pixel Week 6." },
    { "match": "assets/music/freakyMenu\\.mp3", "role": "music", "screens": ["title", "menu"], "note": "Musica dei menu (freakyMenu)." },
    { "match": "assets/music/", "role": "music", "screens": ["menu"], "note": "Musica menu aggiuntiva." },
    { "match": "assets/sounds/", "role": "sfx", "screens": ["menu"], "note": "SFX dei menu (scroll/cancel/confirm)." },
    { "match": "assets/songs/([a-z0-9\\-]+)/Inst\\.mp3", "role": "music", "screens": ["gameplay"], "note": "Canzone '$1': traccia strumentale (Inst) caricata a inizio partita." },
    { "match": "assets/songs/([a-z0-9\\-]+)/Voices\\.mp3", "role": "music", "screens": ["gameplay"], "note": "Canzone '$1': traccia vocale (Voices), sincronizzata all'Inst." },
    { "match": "assets/fonts/", "role": "font", "screens": ["menu", "gameplay"], "note": "Font bitmap del gioco: 'VCR OSD Mono' (testi gioco) e 'Pixel Arial 11 Bold' (UI)." },
    { "match": "flixel/fonts/", "role": "font", "screens": ["menu"], "note": "Font engine HaxeFlixel (nokiafc22, monsterrat): usati da loghi/debug." },
    { "match": "assets/data/freeplaySonglist\\.txt", "role": "text", "screens": ["freeplay"], "note": "Lista brani del Freeplay (nome:difficoltà)." },
    { "match": "assets/data/characterList\\.txt", "role": "text", "screens": ["gameplay"], "note": "Lista personaggi icone salute." },
    { "match": "assets/data/controls\\.txt", "role": "text", "screens": ["menu"], "note": "Testo istruzioni controlli." },
    { "match": "assets/data/introText\\.txt", "role": "text", "screens": ["title"], "note": "Frasi casuali mostrate prima del titolo." },
    { "match": "assets/data/specialThanks\\.txt", "role": "text", "screens": ["menu"], "note": "Ringraziamenti speciali." },
    { "match": "assets/week6/images/weeb/(spirit|weebTrees)\\.txt", "role": "text", "screens": ["week6"], "note": "Dati animazione per frame statici (Spirit/Alberi)." },
    { "match": "changelog\\.txt", "role": "text", "screens": ["menu"], "note": "Changelog della versione 0.3.0." },
    { "match": "mods/", "role": "text", "screens": ["title"], "note": "Mod introMod: testo intro custom (sistema Polymod)." },
    { "match": "flixel/", "role": "engine", "screens": [], "note": "Asset di engine HaxeFlixel (logo, beep, UI debug)." }
  ],
  "exclude": [
    "Funkin\\.js",
    "index\\.html",
    "manifest/.*\\.json",
    "assets/data/.*/.*\\.json",
    "assets/data/data-goes-here\\.txt",
    "assets/shared/images/images-go-here\\.txt",
    "assets/shared/sounds/sounds-go-here\\.txt",
    "assets/fonts/fonts-go-here\\.txt",
    "assets/week[0-9]/week[0-9]_stuff_here\\.txt",
    "assets/shared/week[0-9]/.*",
    "assets/tutorial/.*",
    "assets/week[0-9]/images/.*goes-here",
    "\\.(dat|ini)$"
  ],
  "notes": {
    "reskin": "Gli sprite personaggi/oggetti usano atlas Sparrow v2: PNG + XML con frame name/x/y/w/h. Per reskinare: ridisegna i frame nel PNG mantenendo STESSO nome file, stesse dimensioni PNG e STESSO layout dei frame (coordinate nell'XML invariato). Il testo 'frames' nel manifest elenca nome e dimensione di ogni frame.",
    "fonts": "I font woff (vcr, pixel) si sostituiscono mantenendo lo stesso nome file/famiglia.",
    "charts": "I chart delle canzoni (assets/data/<song>/<song>.json) sono esclusi dal manifesto: sono dati di gioco, non asset creativi.",
    "audio": "Inst.mp3 = strumentale, Voices.mp3 = voci: sostituendo uno dei due il gioco continua (no checksum), basta stesso nome/path e un mp3 valido."
  }
}
